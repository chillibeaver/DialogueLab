# Copy (don't rename) to .dev.vars for local development (`npm run dev`).
# Never commit .dev.vars.

# --- Google credentials ---
# Which one you need depends on the engine. Verified against Google:
#
#   Chirp 3: HD  -> API key is enough.
#   Gemini-TTS   -> service account only. Google routes it to Vertex AI and
#                   checks aiplatform.endpoints.predict; an API key only
#                   identifies a project, so it can never hold that role.

# API key for Chirp 3: HD. Console -> APIs & Services -> Credentials ->
# Create API key, then restrict it to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=AIza...

# Service account key JSON, on ONE line, wrapped in SINGLE quotes (double
# quotes would make dotenv rewrite the \n escapes in private_key). Needs the
# Vertex AI User role. Required for Gemini-TTS; also works for Chirp 3: HD.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}'

# Skip Turnstile locally. Never set this in production.
TURNSTILE_DISABLED=true
# Or test the real check with Cloudflare's always-pass test secret:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
